<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đề Thi Toán Lớp 2 - Chương 1</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Confetti hiệu ứng pháo hoa khi làm bài điểm cao -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Nunito', sans-serif; }
    </style>
</head>
<body class="bg-blue-50 min-h-screen py-8 px-4">

    <div class="max-w-3xl mx-auto bg-white rounded-3xl shadow-xl overflow-hidden border-4 border-yellow-300">
        
        <!-- Header banner -->
        <div class="bg-gradient-to-r from-blue-500 to-indigo-600 text-white text-center py-6 px-4">
            <h1 class="text-3xl font-extrabold tracking-wide uppercase">🌟 BÀI KIỂM TRA TOÁN LỚP 2 🌟</h1>
            <p class="text-lg font-semibold text-yellow-200 mt-1">Chương 1: Ôn tập & Bổ sung | Thời gian: 35 phút</p>
        </div>

        <form id="quizForm" class="p-6 md:p-8 space-y-8">
            
            <!-- THÔNG TIN HỌC SINH -->
            <div class="bg-amber-50 p-4 rounded-2xl border-2 border-amber-200 flex flex-col md:flex-row gap-4">
                <div class="flex-1">
                    <label class="block font-bold text-gray-700 mb-1">👤 Họ và tên học sinh:</label>
                    <input type="text" id="studentName" required placeholder="Nhập tên của em..." class="w-full px-4 py-2 rounded-xl border-2 border-amber-300 focus:outline-none focus:ring-2 focus:ring-amber-500 font-semibold text-lg">
                </div>
                <div class="w-full md:w-36">
                    <label class="block font-bold text-gray-700 mb-1">🏫 Lớp:</label>
                    <input type="text" id="studentClass" placeholder="Ví dụ: 2A1" class="w-full px-4 py-2 rounded-xl border-2 border-amber-300 focus:outline-none focus:ring-2 focus:ring-amber-500 font-semibold text-lg text-center">
                </div>
            </div>

            <!-- PHẦN 1: TRẮC NGHIỆM -->
            <div>
                <div class="bg-indigo-100 text-indigo-900 font-extrabold px-4 py-2 rounded-xl text-lg flex items-center gap-2">
                    <span>📌 PHẦN 1: TRẮC NGHIỆM</span>
                    <span class="text-sm font-normal text-indigo-700">(Nhấp chuột chọn 1 đáp án đúng - 5 điểm)</span>
                </div>

                <div class="mt-4 space-y-4">
                    <!-- Câu 1 -->
                    <div class="p-4 rounded-2xl bg-gray-50 border border-gray-200">
                        <p class="font-bold text-gray-800 text-lg mb-2">Câu 1. Số liền sau của số <span class="text-blue-600 font-extrabold">89</span> là số nào?</p>
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-2">
                            <label class="flex items-center gap-2 bg-white p-3 rounded-xl border hover:border-blue-500 cursor-pointer"><input type="radio" name="q1" value="A" class="w-5 h-5 text-blue-600"> A. 88</label>
                            <label class="flex items-center gap-2 bg-white p-3 rounded-xl border hover:border-blue-500 cursor-pointer"><input type="radio" name="q1" value="B" class="w-5 h-5 text-blue-600"> B. 90</label>
                            <label class="flex items-center gap-2 bg-white p-3 rounded-xl border hover:border-blue-500 cursor-pointer"><input type="radio" name="q1" value="C" class="w-5 h-5 text-blue-600"> C. 91</label>
                            <label class="flex items-center gap-2 bg-white p-3 rounded-xl border hover:border-blue-500 cursor-pointer"><input type="radio" name="q1" value="D" class="w-5 h-5 text-blue-600"> D. 80</label>
                        </div>
                    </div>

                    <!-- Câu 2 -->
                    <div class="p-4 rounded-2xl bg-gray-50 border border-gray-200">
                        <p class="font-bold text-gray-800 text-lg mb-2">Câu 2. Trong phép tính <span class="text-blue-600 font-extrabold">34 + 12 = 46</span>, số <span class="text-blue-600 font-extrabold">46</span> được gọi là gì?</p>
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-2">
                            <label class="flex items-center gap-2 bg-white p-3 rounded-xl border hover:border-blue-500 cursor-pointer"><input type="radio" name="q2" value="A" class="w-5 h-5 text-blue-600"> A. Số hạng</label>
                            <label class="flex items-center gap-2 bg-white p-3 rounded-xl border hover:border-blue-500 cursor-pointer"><input type="radio" name="q2" value="B" class="w-5 h-5 text-blue-600"> B. Số trừ</label>
                            <label class="flex items-center gap-2 bg-white p-3 rounded-xl border hover:border-blue-500 cursor-pointer"><input type="radio" name="q2" value="C" class="w-5 h-5 text-blue-600"> C. Tổng</label>
                            <label class="flex items-center gap-2 bg-white p-3 rounded-xl border hover:border-blue-500 cursor-pointer"><input type="radio" name="q2" value="D" class="w-5 h-5 text-blue-600"> D. Hiệu</label>
                        </div>
                    </div>

                    <!-- Câu 3 -->
                    <div class="p-4 rounded-2xl bg-gray-50 border border-gray-200">
                        <p class="font-bold text-gray-800 text-lg mb-2">Câu 3. Số gồm <span class="text-blue-600 font-extrabold">7 chục</span> và <span class="text-blue-600 font-extrabold">2 đơn vị</span> được viết là:</p>
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-2">
                            <label class="flex items-center gap-2 bg-white p-3 rounded-xl border hover:border-blue-500 cursor-pointer"><input type="radio" name="q3" value="A" class="w-5 h-5 text-blue-600"> A. 27</label>
                            <label class="flex items-center gap-2 bg-white p-3 rounded-xl border hover:border-blue-500 cursor-pointer"><input type="radio" name="q3" value="B" class="w-5 h-5 text-blue-600"> B. 72</label>
                            <label class="flex items-center gap-2 bg-white p-3 rounded-xl border hover:border-blue-500 cursor-pointer"><input type="radio" name="q3" value="C" class="w-5 h-5 text-blue-600"> C. 702</label>
                            <label class="flex items-center gap-2 bg-white p-3 rounded-xl border hover:border-blue-500 cursor-pointer"><input type="radio" name="q3" value="D" class="w-5 h-5 text-blue-600"> D. 70</label>
                        </div>
                    </div>

                    <!-- Câu 4 -->
                    <div class="p-4 rounded-2xl bg-gray-50 border border-gray-200">
                        <p class="font-bold text-gray-800 text-lg mb-2">Câu 4. Điền số thích hợp: <span class="text-blue-600 font-extrabold">1 dm = ... cm</span></p>
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-2">
                            <label class="flex items-center gap-2 bg-white p-3 rounded-xl border hover:border-blue-500 cursor-pointer"><input type="radio" name="q4" value="A" class="w-5 h-5 text-blue-600"> A. 10</label>
                            <label class="flex items-center gap-2 bg-white p-3 rounded-xl border hover:border-blue-500 cursor-pointer"><input type="radio" name="q4" value="B" class="w-5 h-5 text-blue-600"> B. 100</label>
                            <label class="flex items-center gap-2 bg-white p-3 rounded-xl border hover:border-blue-500 cursor-pointer"><input type="radio" name="q4" value="C" class="w-5 h-5 text-blue-600"> C. 1</label>
                            <label class="flex items-center gap-2 bg-white p-3 rounded-xl border hover:border-blue-500 cursor-pointer"><input type="radio" name="q4" value="D" class="w-5 h-5 text-blue-600"> D. 0</label>
                        </div>
                    </div>

                    <!-- Câu 5 -->
                    <div class="p-4 rounded-2xl bg-gray-50 border border-gray-200">
                        <p class="font-bold text-gray-800 text-lg mb-2">Câu 5. An có 8 quả bóng, Bình có 7 quả bóng. Cả hai bạn có tất cả bao nhiêu quả bóng?</p>
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-2">
                            <label class="flex items-center gap-2 bg-white p-3 rounded-xl border hover:border-blue-500 cursor-pointer"><input type="radio" name="q5" value="A" class="w-5 h-5 text-blue-600"> A. 14 quả</label>
                            <label class="flex items-center gap-2 bg-white p-3 rounded-xl border hover:border-blue-500 cursor-pointer"><input type="radio" name="q5" value="B" class="w-5 h-5 text-blue-600"> B. 15 quả</label>
                            <label class="flex items-center gap-2 bg-white p-3 rounded-xl border hover:border-blue-500 cursor-pointer"><input type="radio" name="q5" value="C" class="w-5 h-5 text-blue-600"> C. 16 quả</label>
                            <label class="flex items-center gap-2 bg-white p-3 rounded-xl border hover:border-blue-500 cursor-pointer"><input type="radio" name="q5" value="D" class="w-5 h-5 text-blue-600"> D. 13 quả</label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- PHẦN 2: ĐIỀN DẤU -->
            <div>
                <div class="bg-indigo-100 text-indigo-900 font-extrabold px-4 py-2 rounded-xl text-lg flex items-center gap-2">
                    <span>✏️ PHẦN 2: ĐIỀN DẤU (&gt;, &lt;, =)</span>
                    <span class="text-sm font-normal text-indigo-700">(Gõ dấu &gt;, &lt; hoặc = vào ô trống - 2 điểm)</span>
                </div>

                <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="p-4 rounded-2xl bg-gray-50 border border-gray-200">
                        <p class="font-bold text-gray-800 text-lg mb-3">Câu 6. Điền dấu thích hợp:</p>
                        <div class="space-y-3 font-semibold text-lg">
                            <div class="flex items-center gap-2">
                                <span>a) 54 + 5</span>
                                <input type="text" id="q6a" maxlength="1" class="w-12 h-12 text-center text-xl font-bold bg-white border-2 border-indigo-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                                <span>60</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <span>b) 4 dm</span>
                                <input type="text" id="q6b" maxlength="1" class="w-12 h-12 text-center text-xl font-bold bg-white border-2 border-indigo-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                                <span>40 cm</span>
                            </div>
                        </div>
                    </div>

                    <div class="p-4 rounded-2xl bg-gray-50 border border-gray-200">
                        <p class="font-bold text-gray-800 text-lg mb-3">Câu 7. Điền dấu thích hợp:</p>
                        <div class="space-y-3 font-semibold text-lg">
                            <div class="flex items-center gap-2">
                                <span>a) 9 + 7</span>
                                <input type="text" id="q7a" maxlength="1" class="w-12 h-12 text-center text-xl font-bold bg-white border-2 border-indigo-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                                <span>8 + 8</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <span>b) 14 - 6</span>
                                <input type="text" id="q7b" maxlength="1" class="w-12 h-12 text-center text-xl font-bold bg-white border-2 border-indigo-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                                <span>15 - 8</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- PHẦN 3: NHẬP KẾT QUẢ -->
            <div>
                <div class="bg-indigo-100 text-indigo-900 font-extrabold px-4 py-2 rounded-xl text-lg flex items-center gap-2">
                    <span>💡 PHẦN 3: TRẢ LỜI KẾT QUẢ</span>
                    <span class="text-sm font-normal text-indigo-700">(Gõ đáp số vào ô trống - 3 điểm)</span>
                </div>

                <div class="mt-4 space-y-4">
                    <div class="p-4 rounded-2xl bg-gray-50 border border-gray-200">
                        <p class="font-bold text-gray-800 text-lg mb-2">Câu 8. Tính nhẩm:</p>
                        <div class="flex items-center gap-3 font-bold text-lg">
                            <span>9 + 6 = </span>
                            <input type="text" id="q8" class="w-24 h-12 text-center text-xl font-bold bg-white border-2 border-indigo-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:outline-none" placeholder="?">
                        </div>
                    </div>

                    <div class="p-4 rounded-2xl bg-gray-50 border border-gray-200">
                        <p class="font-bold text-gray-800 text-lg mb-2">Câu 9. Tìm một số, biết số đó trừ đi 20 thì được kết quả là 45.</p>
                        <div class="flex items-center gap-3 font-bold text-lg">
                            <span>Số cần tìm là:</span>
                            <input type="text" id="q9" class="w-24 h-12 text-center text-xl font-bold bg-white border-2 border-indigo-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:outline-none" placeholder="?">
                        </div>
                    </div>

                    <div class="p-4 rounded-2xl bg-gray-50 border border-gray-200">
                        <p class="font-bold text-gray-800 text-lg mb-2">Câu 10. Một đoạn dây dài 19 dm, cắt bớt đi 9 dm. Hỏi đoạn dây còn lại dài bao nhiêu đề-xi-mét?</p>
                        <div class="flex items-center gap-3 font-bold text-lg">
                            <span>Đáp số (chỉ nhập số):</span>
                            <input type="text" id="q10" class="w-24 h-12 text-center text-xl font-bold bg-white border-2 border-indigo-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:outline-none" placeholder="?">
                            <span>dm</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Nút Nộp Bài -->
            <div class="text-center pt-4">
                <button type="button" onclick="submitExam()" class="w-full md:w-2/3 py-4 bg-gradient-to-r from-green-500 to-emerald-600 hover:from-green-600 hover:to-emerald-700 text-white font-extrabold text-2xl rounded-2xl shadow-lg transition-all transform active:scale-95">
                    🚀 NỘP BÀI THI NGAY
                </button>
            </div>
        </form>

        <!-- KẾT QUẢ POPUP -->
        <div id="resultModal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4 z-50">
            <div class="bg-white rounded-3xl max-w-md w-full p-6 text-center shadow-2xl border-4 border-yellow-300 transform transition-all">
                <div id="resultIcon" class="text-6xl mb-2">🎉</div>
                <h2 id="resultTitle" class="text-2xl font-black text-gray-800">KẾT QUẢ BÀI LÀM</h2>
                <p id="studentInfoDisplay" class="text-gray-600 font-semibold mt-1"></p>
                <div class="my-6 p-4 bg-blue-50 rounded-2xl">
                    <span class="text-gray-600 font-bold block">Tổng điểm đạt được:</span>
                    <span id="finalScore" class="text-5xl font-extrabold text-blue-600">10/10</span>
                </div>
                <p id="feedbackText" class="text-gray-700 font-bold mb-6"></p>
                <button onclick="closeModal()" class="w-full py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl text-lg">Làm lại bài khác</button>
            </div>
        </div>

    </div>

    <script>
        function submitExam() {
            const name = document.getElementById('studentName').value.trim();
            if (!name) {
                alert('Em hãy nhập Họ và Tên trước khi nộp bài nhé!');
                document.getElementById('studentName').focus();
                return;
            }

            let score = 0;

            // Chấm Phần 1: Trắc nghiệm (5đ)
            if (document.querySelector('input[name="q1"]:checked')?.value === 'B') score += 1;
            if (document.querySelector('input[name="q2"]:checked')?.value === 'C') score += 1;
            if (document.querySelector('input[name="q3"]:checked')?.value === 'B') score += 1;
            if (document.querySelector('input[name="q4"]:checked')?.value === 'A') score += 1;
            if (document.querySelector('input[name="q5"]:checked')?.value === 'B') score += 1;

            // Chấm Phần 2: Điền dấu (2đ)
            if (document.getElementById('q6a').value.trim() === '<') score += 0.5;
            if (document.getElementById('q6b').value.trim() === '=') score += 0.5;
            if (document.getElementById('q7a').value.trim() === '=') score += 0.5;
            if (document.getElementById('q7b').value.trim() === '>') score += 0.5;

            // Chấm Phần 3: Trả lời kết quả (3đ)
            if (document.getElementById('q8').value.trim() === '15') score += 1;
            if (document.getElementById('q9').value.trim() === '65') score += 1;
            if (document.getElementById('q10').value.trim() === '10') score += 1;

            // Hiển thị kết quả
            const className = document.getElementById('studentClass').value.trim();
            document.getElementById('studentInfoDisplay').innerText = `Học sinh: ${name} ${className ? '('+className+')' : ''}`;
            document.getElementById('finalScore').innerText = `${score} / 10`;

            const icon = document.getElementById('resultIcon');
            const feedback = document.getElementById('feedbackText');

            if (score === 10) {
                icon.innerText = '🏆';
                feedback.innerText = 'Xuất sắc tuyệt đối! Em làm bài rất cẩn thận và giỏi giang!';
                confetti({ particleCount: 150, spread: 80, origin: { y: 0.6 } });
            } else if (score >= 8) {
                icon.innerText = '🌟';
                feedback.innerText = 'Rất tốt! Em chỉ nhầm một chút xíu thôi, cố lên nhé!';
                confetti({ particleCount: 80, spread: 60, origin: { y: 0.6 } });
            } else if (score >= 5) {
                icon.innerText = '👏';
                feedback.innerText = 'Khá khen! Em hãy ôn lại các phép tính Chương 1 để đạt điểm 10 nhé!';
            } else {
                icon.innerText = '💪';
                feedback.innerText = 'Em cần đọc kỹ lại đề và làm lại lần nữa nhé!';
            }

            document.getElementById('resultModal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('resultModal').classList.add('hidden');
            document.getElementById('quizForm').reset();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    </script>
</body>
</html>